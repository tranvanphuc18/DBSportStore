@model DBSportStore.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>Xóa sản phẩm</h2>

<h3>Bạn có chắc muốn xóa sản phẩm này không?</h3>

@* Hiển thị lỗi nếu sản phẩm không xóa được (đã có trong đơn hàng) *@
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div>
    <h4>Thông tin sản phẩm</h4>
    <hr />

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div style="margin:15px 0;">
            <img src="~/Content/images/@Model.ImageUrl"
                 alt="@Model.ProductName"
                 style="width:180px; height:180px; object-fit:cover;
                        border-radius:12px; border:1px solid #ddd;" />
        </div>
    }

    <dl class="dl-horizontal">
        <dt>Tên sản phẩm</dt>
        <dd>@Html.DisplayFor(model => model.ProductName)</dd>

        <dt>Mô tả</dt>
        <dd>@Html.DisplayFor(model => model.Description)</dd>

        <dt>Danh mục</dt>
        <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>

        <dt>Đơn giá</dt>
        <dd>@Model.Price.ToString("#,##0") đ</dd>

        <dt>Số lượng tồn kho</dt>
        <dd>@Html.DisplayFor(model => model.StockQuantity)</dd>

        <dt>Trạng thái</dt>
        <dd>@(Model.IsActive ? "Đang bán" : "Ngừng bán")</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
            @Html.ActionLink("Quay lại danh sách", "Index")
        </div>
    }
</div>
